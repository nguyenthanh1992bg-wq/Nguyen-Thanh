# ===== Copy thành .env rồi điền. KHÔNG commit file .env =====
ANTHROPIC_API_KEY=

# Telegram: tạo bot qua @BotFather (/newbot) -> dán token. Nhắn bất kỳ tin cho bot, bot sẽ trả lại CHAT ID để điền.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook FANPAGE (API không đăng được lên trang cá nhân). Cần Page ID + Page Access Token dài hạn
# quyền: pages_manage_posts, pages_read_engagement, pages_show_list, publish_video
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_DRY_RUN=1            # 1 = thử, KHÔNG đăng thật. Đổi 0 khi đã kiểm tra xong

# Google Drive (chạy python -m agent.auth_drive một lần để tạo secrets/drive_token.json)
DRIVE_IN_PATH=AI AGENT VIDEO/VIDEO QUAY THÔ
DRIVE_OUT_PATH=AI AGENT VIDEO/VIDEO AI AGENT DỰNG XONG
SCAN_INTERVAL_MIN=30
POST_TIMES=08:00,20:00
TZ_NAME=Asia/Ho_Chi_Minh

# Máy chủ Linux không có Chrome thì chỉ đường dẫn (tuỳ chọn); EAC_CONCURRENCY = số luồng render
#EAC_BROWSER=/usr/bin/chromium
#EAC_CONCURRENCY=2
#EAC_WHISPER_MODEL=large-v3-turbo
