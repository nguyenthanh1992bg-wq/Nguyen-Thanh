# sudo cp ai-agent-video.service /etc/systemd/system/ && sudo systemctl enable --now ai-agent-video
[Unit]
Description=AI Agent edit video Am Cam
After=network-online.target
[Service]
WorkingDirectory=/opt/ai-agent-video
ExecStart=/opt/ai-agent-video/run.sh
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
